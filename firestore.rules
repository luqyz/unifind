rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // NOTE: role/isBanned now live in the private subcollection, not the
    // public users/{uid} document — these helpers read from the new path.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data).data.role == 'admin';
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/private/data).data.isBanned == true;
    }

    // Explicit collection-group rule for messages, as a fallback to ensure
    // collectionGroup() queries across all items are properly authorized.
    match /{path=**}/messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
    }

    // Same fallback for the users/{uid}/private/{docId} subcollection —
    // needed so the admin dashboard's collectionGroup('private') query
    // (which lists every user's private doc at once) is authorized.
    // path looks like ['users', '<uid>', 'private', 'data'].
    match /{path=**}/private/{docId} {
      allow read: if signedIn() && (
        isAdmin() || request.auth.uid == path.split('/')[1]
      );
    }

    // Users collection — PUBLIC fields only (no email, role, or ban status).
    // Anything sensitive lives in the private subcollection below instead.
    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.displayName is string &&
        request.resource.data.provider in ['email', 'google', 'anonymous'] &&
        request.resource.data.isVerified == false &&
        request.resource.data.createdAt is timestamp;

      // Owner can update their own public profile (e.g. displayName), but
      // never isVerified or uid — those require isAdmin() / stay frozen.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.isVerified == resource.data.isVerified &&
        request.resource.data.uid == resource.data.uid
      );
      allow delete: if isAdmin();

      // Private profile data — email, role, ban status. Only the owner
      // themselves or an admin can ever read this subcollection.
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();

        allow create: if isOwner(userId) &&
          request.resource.data.email is string &&
          request.resource.data.role == 'user' &&
          request.resource.data.isBanned == false;

        // Owner may update their own email, but role/isBanned are frozen
        // unless the write comes from an admin — this is the fix for the
        // original self-privilege-escalation issue.
        allow update: if isAdmin() || (
          isOwner(userId) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isBanned == resource.data.isBanned
        );
        allow delete: if isAdmin();
      }
    }

    // Items collection - public read, authenticated create, restricted update/delete
    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn() && !isBanned() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.description is string &&
        request.resource.data.category is string &&
        request.resource.data.type in ['lost', 'found'] &&
        request.resource.data.location is string &&
        request.resource.data.location.size() > 0 &&
        request.resource.data.dateOccurred is string &&
        request.resource.data.status == 'open' &&
        request.resource.data.isDeleted == false &&
        request.resource.data.isHidden == false &&
        request.resource.data.flaggedCount == 0 &&
        request.resource.data.createdAt is timestamp &&
        (!('privateDetails' in request.resource.data) || request.resource.data.privateDetails is string) &&
        (!('hasReward' in request.resource.data) || request.resource.data.hasReward is bool);

      allow update: if (
        (isOwner(resource.data.userId) && !isBanned()) || isAdmin()
      ) &&
        (request.resource.data.title == resource.data.title || isOwner(resource.data.userId)) &&
        request.resource.data.status in ['open', 'resolved', 'claimed'] &&
        request.resource.data.userId == resource.data.userId &&
        (isAdmin() || request.resource.data.isHidden == resource.data.isHidden) &&
        (isAdmin() || request.resource.data.flaggedCount == resource.data.flaggedCount) &&
        (isAdmin() || request.resource.data.isDeleted == resource.data.isDeleted);
      allow delete: if isOwner(resource.data.userId) || isAdmin();

      // Messages subcollection for safe contact
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in resource.data.participants;

        allow create: if signedIn() && !isBanned() &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.receiverId is string &&
          request.resource.data.receiverId != request.auth.uid &&
          request.resource.data.itemId == itemId &&
          request.resource.data.participants is list &&
          request.resource.data.participants.size() == 2 &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.receiverId in request.resource.data.participants &&
          get(/databases/$(database)/documents/items/$(itemId)).data.userId in request.resource.data.participants &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.createdAt is timestamp;
        allow delete: if false;
      }
    }

    // Reports collection - private, admin only for modification
    match /reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if signedIn() && !isBanned() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.itemId is string &&
        request.resource.data.reportedUserUid is string &&
        request.resource.data.reason in ['spam', 'misleading', 'harassment', 'inappropriate', 'other'] &&
        request.resource.data.details is string &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.reviewedBy == null &&
        request.resource.data.resolution == null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
